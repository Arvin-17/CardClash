# Copy to server/.env for local development. Never commit the real .env.
DATABASE_URL=sqlite:///./cardclash.db
# Secret for admin-only endpoints (DELETE /run/{id}). Leave empty to disable them.
ADMIN_KEY=
# Comma-separated origins allowed to call the API. In production: only the game's origin.
ALLOWED_ORIGINS=http://localhost:8060,http://127.0.0.1:8060,http://localhost:8000
# Runs from builds older than this version are rejected.
GAME_VERSION=0.2.0
